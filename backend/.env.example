APP_ENV=development

# PostgreSQL connection string
# Example:
# postgresql+psycopg://postgres:password@localhost:5432/multi_agent_db
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/multi_agent_db

# Gemini / Google AI API key
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# JWT settings for auth
JWT_SECRET_KEY=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
